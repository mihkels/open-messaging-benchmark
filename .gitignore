.classpath
.project
.settings
.pydevproject
target
/.metadata/
*.pyc
*.svg
core/*.json
*.json
# Test fixtures, unlike benchmark results, belong in the repository
!**/src/test/resources/**/*.json
*.retry
*.pem
*.hcl
**/.terraform
**/terraform.tfstate
**/terraform.tfstate.backup
**/*.lock.info
.DS_Store
.factorypath

# IntelliJ artifacts
.idea/
*.iml
.flattened-pom.xml

# Benchmark supervisor and driver process logs
benchmark-worker.log*
benchmark-driver.log*
site/
.venv/

# Documentation site assets and the recorded landing page demo
!docs/assets/**/*.svg
!docs/assets/*.svg
!docs/demo/*.json
