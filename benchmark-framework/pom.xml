<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.openmessaging.benchmark</groupId>
        <artifactId>messaging-benchmark</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>benchmark-framework</artifactId>

    <properties>
        <!-- Coverage floors, see docs/development/building-the-project.md#coverage-thresholds -->
        <jacoco.min.class>0.95</jacoco.min.class>
        <jacoco.min.method>0.89</jacoco.min.method>
        <jacoco.min.line>0.87</jacoco.min.line>
        <jacoco.min.branch>0.81</jacoco.min.branch>
        <hdrhistogram.version>2.2.2</hdrhistogram.version>
        <async.client.version>3.0.14</async.client.version>
        <javalin.version>7.2.4</javalin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>driver-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>${javalin.version}</version>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>
        <dependency>
            <groupId>io.prometheus</groupId>
            <artifactId>prometheus-metrics-exposition-formats</artifactId>
        </dependency>
        <dependency>
            <groupId>io.prometheus</groupId>
            <artifactId>prometheus-metrics-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-artifact</artifactId>
            <version>3.10.0</version>
        </dependency>
        <dependency>
            <groupId>org.asynchttpclient</groupId>
            <artifactId>async-http-client</artifactId>
            <version>${async.client.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hdrhistogram</groupId>
            <artifactId>HdrHistogram</artifactId>
            <version>${hdrhistogram.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jcommander</groupId>
            <artifactId>jcommander</artifactId>
        </dependency>
        <dependency>
            <!-- Nullness annotations checked by NullAway at compile time -->
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.stefanbirkner</groupId>
            <artifactId>system-lambda</artifactId>
            <version>1.2.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven.dependency.plugin.version}</version>
                <executions>
                    <execution>
                        <id>build-classpath</id>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <outputFile>target/classpath.txt</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <!--
                            Records the core artifacts that every driver process needs. Driver processes get
                            these plus the selected plugin bundle; coordinator-only HTTP client libraries are
                            excluded so they cannot clash with driver dependencies.
                        -->
                        <id>worker-runtime-artifacts</id>
                        <goals>
                            <goal>list</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <outputFile>${project.build.outputDirectory}/META-INF/omb/worker-runtime-artifacts.txt</outputFile>
                            <includeScope>runtime</includeScope>
                            <excludeGroupIds>io.netty,org.asynchttpclient,com.typesafe.netty,org.reactivestreams,com.google.guava,com.google.errorprone,com.google.j2objc,org.checkerframework,com.google.code.findbugs,org.jcommander,com.sun.activation,jakarta.activation,org.apache.commons</excludeGroupIds>
                            <sort>true</sort>
                            <appendOutput>false</appendOutput>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                    Upper-bound dependency check is applied only to the host-side modules
                    (driver-api, benchmark-framework, tool). Drivers are deliberately left out:
                    driver isolation lets each driver ship its own broker-client dependency versions.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-upper-bound-deps</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <!--
                Opt-in PIT mutation testing: mvn -Pmutation verify -pl driver-api,benchmark-framework
                Only deterministic code is mutated: stats and histogram math (worker.commands, worker.jackson),
                configuration parsing (Workload, Thresholds, plugin descriptors and coordinates), rate control
                and the pure utilities. Coordinator orchestration, worker processes, HTTP/IPC and the timing
                helper are excluded, and their tests are not run, because they are slow, flaky under mutation
                or need real processes. Report: target/pit-reports/index.html (and mutations.xml).
            -->
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses>
                                <param>io.openmessaging.benchmark.RateController*</param>
                                <param>io.openmessaging.benchmark.Thresholds*</param>
                                <param>io.openmessaging.benchmark.Workload</param>
                                <param>io.openmessaging.benchmark.Workload$*</param>
                                <param>io.openmessaging.benchmark.ResultsToCsv*</param>
                                <param>io.openmessaging.benchmark.plugin.ArtifactCoordinates*</param>
                                <param>io.openmessaging.benchmark.plugin.PluginDescriptor*</param>
                                <param>io.openmessaging.benchmark.utils.*</param>
                                <param>io.openmessaging.benchmark.worker.commands.*</param>
                                <param>io.openmessaging.benchmark.worker.jackson.*</param>
                                <param>io.openmessaging.benchmark.worker.JvmOptions*</param>
                                <param>io.openmessaging.benchmark.worker.LatencyMetric*</param>
                                <param>io.openmessaging.benchmark.worker.WorkerStats*</param>
                            </targetClasses>
                            <excludedClasses>
                                <!-- Wall-clock helper; mutants only change elapsed-time readings -->
                                <param>io.openmessaging.benchmark.utils.Timer*</param>
                                <!-- File-system permissions, not logic -->
                                <param>io.openmessaging.benchmark.utils.SecureTempFiles*</param>
                            </excludedClasses>
                            <targetTests>
                                <param>io.openmessaging.benchmark.RateControllerTest</param>
                                <param>io.openmessaging.benchmark.ThresholdsTest</param>
                                <param>io.openmessaging.benchmark.WorkloadTest</param>
                                <param>io.openmessaging.benchmark.ResultsToCsvTest</param>
                                <param>io.openmessaging.benchmark.plugin.ArtifactCoordinatesTest</param>
                                <param>io.openmessaging.benchmark.plugin.PluginDescriptorTest</param>
                                <param>io.openmessaging.benchmark.utils.*Test</param>
                                <param>io.openmessaging.benchmark.worker.commands.*Test</param>
                                <param>io.openmessaging.benchmark.worker.jackson.*Test</param>
                                <param>io.openmessaging.benchmark.worker.JvmOptionsTest</param>
                                <param>io.openmessaging.benchmark.worker.LatencyMetricTest</param>
                                <param>io.openmessaging.benchmark.worker.WorkerStatsTest</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>io.openmessaging.benchmark.utils.TimerTest</param>
                                <param>io.openmessaging.benchmark.utils.SecureTempFilesTest</param>
                            </excludedTestClasses>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
