<!-- OMB_LOG_FORMAT=json (or -Domb.log.format=json) switches every appender to ECS JSON -->
<Configuration status="INFO" name="messaging-benchmark">
    <Properties>
        <Property name="logName">${sys:omb.log.name:-benchmark-worker}</Property>
        <Property name="pattern">%d{HH:mm:ss.SSS} [%t] %-4level %c{1} - %msg%n</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <Select>
                <SystemPropertyArbiter propertyName="omb.log.format" propertyValue="json">
                    <JsonTemplateLayout eventTemplateUri="classpath:EcsLayout.json"/>
                </SystemPropertyArbiter>
                <EnvironmentArbiter propertyName="OMB_LOG_FORMAT" propertyValue="json">
                    <JsonTemplateLayout eventTemplateUri="classpath:EcsLayout.json"/>
                </EnvironmentArbiter>
                <DefaultArbiter>
                    <PatternLayout pattern="${pattern}"/>
                </DefaultArbiter>
            </Select>
        </Console>
        <RollingFile name="RollingFile" fileName="${logName}.log"
                     filePattern="${logName}.log.%d{yyyy-MM-dd-hh-mm-ss}.gz">
            <Select>
                <SystemPropertyArbiter propertyName="omb.log.format" propertyValue="json">
                    <JsonTemplateLayout eventTemplateUri="classpath:EcsLayout.json"/>
                </SystemPropertyArbiter>
                <EnvironmentArbiter propertyName="OMB_LOG_FORMAT" propertyValue="json">
                    <JsonTemplateLayout eventTemplateUri="classpath:EcsLayout.json"/>
                </EnvironmentArbiter>
                <DefaultArbiter>
                    <PatternLayout pattern="${pattern}"/>
                </DefaultArbiter>
            </Select>
            <Policies>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Root>
    </Loggers>
</Configuration>
