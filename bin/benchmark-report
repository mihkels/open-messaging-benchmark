# Reports on benchmark result files, for example: bin/benchmark-report diff baseline.json candidate.json
BASE_DIR=$(cd "$(dirname "$0")/.." && pwd)

if [ -d "$BASE_DIR/tools" ]; then
    CLASSPATH="$BASE_DIR/tools/*:$BASE_DIR/lib/*"
else
    CLASSPATH="$BASE_DIR/tool/target/classes:$(cat "$BASE_DIR/tool/target/classpath.txt")"
fi

if [ -z "$HEAP_OPTS" ]
then
    HEAP_OPTS="-Xmx512m"
fi

exec java -cp "$CLASSPATH" $HEAP_OPTS io.openmessaging.benchmark.tool.report.BenchmarkReport "$@"
