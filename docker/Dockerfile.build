# Build the Project
FROM maven:3.10.0-eclipse-temurin-27-alpine AS build

# Copy sources and Git metadata
COPY . /benchmark/
WORKDIR /benchmark

# Download dependencies and plugins, excluding artifacts built by this reactor.
RUN --mount=type=cache,target=/root/.m2 mvn dependency:go-offline -B -DexcludeReactor=true

# Reap orphaned driver processes created by the supervisor lifecycle tests.
RUN apk add --no-cache tini
RUN --mount=type=cache,target=/root/.m2 tini -s -- mvn install

# Create the benchmark image
FROM amazoncorretto:27-alpine

RUN apk add --no-cache bash

COPY --from=build /benchmark/package/target/openmessaging-benchmark-*-SNAPSHOT-bin.tar.gz /
RUN mkdir /benchmark && tar -xzf openmessaging-benchmark-*-SNAPSHOT-bin.tar.gz -C /benchmark --strip=1 && \
    rm /openmessaging-benchmark-*-SNAPSHOT-bin.tar.gz

WORKDIR /benchmark