{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mihkels.github.io/open-messaging-benchmark/reference/results-schema.json",
  "title": "OpenMessaging Benchmark result",
  "description": "Version 3 result document. Version 2 files omit validity; version 1 files also omit schemaVersion, metadata, summary and histograms.",
  "type": "object",
  "required": ["schemaVersion", "metadata", "summary"],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "metadata": {
      "type": "object",
      "required": [
        "runId",
        "startedAtUtc",
        "finishedAtUtc",
        "ombVersion",
        "gitCommit",
        "jdk",
        "jvmOptions",
        "workerCount",
        "workload",
        "driverConfig"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "startedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "ombVersion": {
          "type": "string"
        },
        "gitCommit": {
          "type": "string"
        },
        "jdk": {
          "type": "string"
        },
        "jvmOptions": {
          "type": "string"
        },
        "workerCount": {
          "type": "integer",
          "minimum": 1
        },
        "workload": {
          "type": "object"
        },
        "driverConfig": {
          "type": "object",
          "description": "Resolved driver YAML with credential-like keys redacted."
        },
        "clockOffsets": {
          "description": "Each worker's clock offset from the coordinator. Absent in older results.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["worker", "role", "offsetMs", "rttMs"],
            "properties": {
              "worker": {
                "type": "string"
              },
              "role": {
                "enum": ["producer", "consumer", "local"]
              },
              "offsetMs": {
                "type": "number"
              },
              "rttMs": {
                "type": "number"
              },
              "driftMs": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "publishRateAvg",
        "consumeRateAvg",
        "throughputMbSec",
        "totalMessagesSent",
        "totalErrors",
        "maxBacklog",
        "targetRate"
      ],
      "properties": {
        "publishRateAvg": {
          "type": "number"
        },
        "consumeRateAvg": {
          "type": "number"
        },
        "throughputMbSec": {
          "type": "number"
        },
        "totalMessagesSent": {
          "type": "integer",
          "minimum": 0
        },
        "totalErrors": {
          "type": "integer",
          "minimum": 0
        },
        "maxBacklog": {
          "type": "integer",
          "minimum": 0
        },
        "targetRate": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL"]
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["limit", "observed", "status"],
            "properties": {
              "limit": {
                "type": "number"
              },
              "observed": {
                "type": "number"
              },
              "status": {
                "enum": ["PASS", "FAIL"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "delivery": {
      "description": "Lost, duplicated and reordered messages for the whole run. Present only for workloads with verifyDelivery.",
      "type": "object",
      "required": ["sent", "received", "lost", "duplicated", "outOfOrder"],
      "properties": {
        "sent": {
          "type": "integer",
          "minimum": 0
        },
        "received": {
          "type": "integer",
          "minimum": 0
        },
        "lost": {
          "type": "integer",
          "minimum": 0
        },
        "duplicated": {
          "type": "integer",
          "minimum": 0
        },
        "outOfOrder": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "consumerPause": {
      "description": "Mid-run consumer pause. Present only for workloads with consumerPause that reached the pause.",
      "type": "object",
      "required": ["startPeriod", "endPeriod", "peakBacklog", "drainSeconds"],
      "properties": {
        "startPeriod": {
          "type": "integer",
          "minimum": 0
        },
        "endPeriod": {
          "type": "integer",
          "minimum": 0
        },
        "peakBacklog": {
          "type": "integer"
        },
        "drainSeconds": {
          "type": ["number", "null"],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "histograms": {
      "type": "object",
      "properties": {
        "publish": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Compressed HdrHistogram for publish latency."
        },
        "publishDelay": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Compressed HdrHistogram for publish-delay latency."
        },
        "endToEnd": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Compressed HdrHistogram for end-to-end latency."
        }
      },
      "required": ["publish", "publishDelay", "endToEnd"],
      "additionalProperties": false
    },
    "workload": {
      "type": "string"
    },
    "driver": {
      "type": "string"
    },
    "messageSize": {
      "type": "integer"
    },
    "topics": {
      "type": "integer"
    },
    "partitions": {
      "type": "integer"
    },
    "producersPerTopic": {
      "type": "integer"
    },
    "consumersPerTopic": {
      "type": "integer"
    },
    "payloadCompressionRatio": {
      "description": "zstd level 3 compressed size divided by original size of the generated payloads, weighted by send frequency. Present only for workloads with a payloadGenerator.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "attempts": {
      "description": "Attempts the run took with --retries; the last one produced this result.",
      "type": "integer",
      "minimum": 1
    },
    "findings": {
      "description": "What the built-in run checks found. Absent when they found nothing.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "severity", "message"],
        "properties": {
          "check": {
            "type": "string"
          },
          "severity": {
            "enum": ["info", "warning", "invalid"]
          },
          "message": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "validity": {
      "description": "The verdict of the findings: invalid with any invalid finding, else warning with any warning finding, else valid.",
      "type": "object",
      "required": ["status", "findings"],
      "properties": {
        "status": {
          "enum": ["valid", "warning", "invalid"]
        },
        "findings": {
          "$ref": "#/properties/findings"
        }
      },
      "additionalProperties": false
    },
    "failedAttempts": {
      "description": "Reason each failed attempt was retried, oldest first. Absent when the first attempt succeeded.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publishRate": {
      "$ref": "#/$defs/numberSeries"
    },
    "publishErrorRate": {
      "$ref": "#/$defs/numberSeries"
    },
    "consumeRate": {
      "$ref": "#/$defs/numberSeries"
    },
    "backlog": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "targetRate": {
      "description": "Target publish rate in msg/s at the end of each period. Absent in files written before it was recorded.",
      "$ref": "#/$defs/numberSeries"
    },
    "workerHealth": {
      "description": "Highest worker load in each period, across workers. Absent when the workers do not report it.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cpu", "gc"],
        "properties": {
          "cpu": {
            "description": "Process CPU time as a fraction of the period times the worker's available cores.",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "gc": {
            "description": "GC pause time as a fraction of the period.",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "rateProbe": {
      "description": "Steps of the max-rate probe. Present only for producerRate: 0 runs.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seconds", "rate", "nextRate", "receiveBacklog", "publishBacklog", "decision"],
        "properties": {
          "seconds": {
            "type": "number"
          },
          "rate": {
            "type": "number"
          },
          "nextRate": {
            "type": "number"
          },
          "receiveBacklog": {
            "type": "integer"
          },
          "publishBacklog": {
            "type": "integer"
          },
          "publishDelayLatency99pct": {
            "type": "integer"
          },
          "decision": {
            "enum": ["rampUp", "receiveBacklog", "publishBacklog"]
          }
        },
        "additionalProperties": false
      }
    },
    "stage": {
      "description": "Index of the running workload stage in each period. Present only for workloads with stages.",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "phase": {
      "description": "Run phase of each period. Warm-up periods come first and are excluded from summary and aggregates. Absent in files written before phases were recorded.",
      "type": "array",
      "items": {
        "enum": ["WARMUP", "BACKLOG_BUILD", "BACKLOG_DRAIN", "MEASURE"]
      }
    }
  },
  "$defs": {
    "numberSeries": {
      "type": "array",
      "items": {
        "type": "number"
      }
    }
  },
  "additionalProperties": true
}
