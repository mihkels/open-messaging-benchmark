{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mihkels.github.io/open-messaging-benchmark/reference/results-schema.json",
  "title": "OpenMessaging Benchmark result",
  "description": "Version 2 result document. Version 1 files omit schemaVersion, metadata, summary and histograms.",
  "type": "object",
  "required": ["schemaVersion", "metadata", "summary"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "metadata": {
      "type": "object",
      "required": [
        "runId",
        "startedAtUtc",
        "finishedAtUtc",
        "ombVersion",
        "gitCommit",
        "jdk",
        "jvmOptions",
        "workerCount",
        "workload",
        "driverConfig"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "startedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "ombVersion": {
          "type": "string"
        },
        "gitCommit": {
          "type": "string"
        },
        "jdk": {
          "type": "string"
        },
        "jvmOptions": {
          "type": "string"
        },
        "workerCount": {
          "type": "integer",
          "minimum": 1
        },
        "workload": {
          "type": "object"
        },
        "driverConfig": {
          "type": "object",
          "description": "Resolved driver YAML with credential-like keys redacted."
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "publishRateAvg",
        "consumeRateAvg",
        "throughputMbSec",
        "totalMessagesSent",
        "totalErrors",
        "maxBacklog",
        "targetRate"
      ],
      "properties": {
        "publishRateAvg": {
          "type": "number"
        },
        "consumeRateAvg": {
          "type": "number"
        },
        "throughputMbSec": {
          "type": "number"
        },
        "totalMessagesSent": {
          "type": "integer",
          "minimum": 0
        },
        "totalErrors": {
          "type": "integer",
          "minimum": 0
        },
        "maxBacklog": {
          "type": "integer",
          "minimum": 0
        },
        "targetRate": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL"]
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["limit", "observed", "status"],
            "properties": {
              "limit": {
                "type": "number"
              },
              "observed": {
                "type": "number"
              },
              "status": {
                "enum": ["PASS", "FAIL"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "histograms": {
      "type": "object",
      "properties": {
        "publish": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Compressed HdrHistogram for publish latency."
        },
        "publishDelay": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Compressed HdrHistogram for publish-delay latency."
        },
        "endToEnd": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Compressed HdrHistogram for end-to-end latency."
        }
      },
      "required": ["publish", "publishDelay", "endToEnd"],
      "additionalProperties": false
    },
    "workload": {
      "type": "string"
    },
    "driver": {
      "type": "string"
    },
    "messageSize": {
      "type": "integer"
    },
    "topics": {
      "type": "integer"
    },
    "partitions": {
      "type": "integer"
    },
    "producersPerTopic": {
      "type": "integer"
    },
    "consumersPerTopic": {
      "type": "integer"
    },
    "payloadCompressionRatio": {
      "description": "zstd level 3 compressed size divided by original size of the generated payloads, weighted by send frequency. Present only for workloads with a payloadGenerator.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "publishRate": {
      "$ref": "#/$defs/numberSeries"
    },
    "publishErrorRate": {
      "$ref": "#/$defs/numberSeries"
    },
    "consumeRate": {
      "$ref": "#/$defs/numberSeries"
    },
    "backlog": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "targetRate": {
      "description": "Target publish rate in msg/s at the end of each period. Absent in files written before it was recorded.",
      "$ref": "#/$defs/numberSeries"
    },
    "stage": {
      "description": "Index of the running workload stage in each period. Present only for workloads with stages.",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "phase": {
      "description": "Run phase of each period. Warm-up periods come first and are excluded from summary and aggregates. Absent in files written before phases were recorded.",
      "type": "array",
      "items": {
        "enum": ["WARMUP", "BACKLOG_BUILD", "BACKLOG_DRAIN", "MEASURE"]
      }
    }
  },
  "$defs": {
    "numberSeries": {
      "type": "array",
      "items": {
        "type": "number"
      }
    }
  },
  "additionalProperties": true
}
