<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.openmessaging.benchmark</groupId>
        <artifactId>messaging-benchmark</artifactId>
        <version>${revision}</version>
    </parent>

    <!--
        Optional OTLP metrics export for workers. The jar shades the Micrometer OTLP registry with a
        relocated protobuf and OpenTelemetry proto, because it sits on the core classpath of every
        driver process, where an unshaded protobuf would replace the version a driver bundles.
    -->
    <artifactId>metrics-otlp</artifactId>

    <properties>
        <!-- Coverage floors, see docs/development/building-the-project.md#coverage-thresholds -->
        <jacoco.min.class>0.90</jacoco.min.class>
        <jacoco.min.method>0.90</jacoco.min.method>
        <jacoco.min.line>0.90</jacoco.min.line>
        <jacoco.min.branch>0.90</jacoco.min.branch>
    </properties>

    <dependencies>
        <dependency>
            <!-- Optional: shaded into this jar, so consumers never see it or protobuf transitively -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <!-- Provided by the benchmark core, which shares it with drivers -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- Nullness annotations checked by NullAway at compile time -->
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <dependencies>
                    <!-- The plugin's own ASM cannot read Java 27 class files -->
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.11.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.11.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>io.micrometer:micrometer-registry-otlp</include>
                                    <include>io.opentelemetry.proto:opentelemetry-proto</include>
                                    <include>com.google.protobuf:protobuf-java</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>io.micrometer.registry.otlp</pattern>
                                    <shadedPattern>io.openmessaging.benchmark.metrics.otlp.shaded.registry</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.opentelemetry.proto</pattern>
                                    <shadedPattern>io.openmessaging.benchmark.metrics.otlp.shaded.proto</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.protobuf</pattern>
                                    <shadedPattern>io.openmessaging.benchmark.metrics.otlp.shaded.protobuf</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>google/protobuf/**</exclude>
                                        <exclude>opentelemetry/proto/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
