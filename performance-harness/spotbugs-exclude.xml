<FindBugsFilter>
    <!-- JMH generates padding fields and execution scaffolding, not application logic. -->
    <Match>
        <Class name="~io\.openmessaging\.benchmark\.(worker|driver)\.jmh_generated\..*" />
    </Match>
    <!--
        This harness-only producer returns an already-completed future solely to MessageProducer,
        which attaches whenComplete and never mutates it. Reuse intentionally excludes future
        allocation from this completed-future accounting benchmark.
    -->
    <Match>
        <Class name="io.openmessaging.benchmark.worker.WorkerHotPathBenchmark$Fixture$1" />
        <Method name="sendAsync" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
</FindBugsFilter>
