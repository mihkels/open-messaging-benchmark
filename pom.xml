        <guava.version>33.8.0-jre</guava.version>
        <archunit.version>1.5.1</archunit.version>
        <assertj.version>3.27.7</assertj.version>
        <bookkeeper.version>4.18.2</bookkeeper.version>
        <checkstyle.version>14.4.0</checkstyle.version>
        <jcommander.version>3.0</jcommander.version>
        <junit.jupiter.version>6.1.3</junit.jupiter.version>
        <mockito.junit.jupiter.version>5.24.0</mockito.junit.jupiter.version>
        <bytebuddy.version>1.18.17</bytebuddy.version>
        <commons.lang3.version>3.21.0</commons.lang3.version>
        <jackson.version>3.2.4</jackson.version>
        <jackson.annotations.version>2.22</jackson.annotations.version>
        <!-- Keep at least the version async-http-client is built against -->
        <netty.version>4.2.20.Final</netty.version>
        <log4j.version>2.26.1</log4j.version>
        <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
        <jacoco.plugin.version>0.8.16</jacoco.plugin.version>
        <license.plugin.version>5.1.2</license.plugin.version>
        <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
        <maven.enforcer.plugin.version>3.7.0</maven.enforcer.plugin.version>
        <maven.surefire.plugin.version>3.6.1</maven.surefire.plugin.version>
        <maven.clean.plugin.version>3.5.0</maven.clean.plugin.version>
        <maven.deploy.plugin.version>3.2.0</maven.deploy.plugin.version>
        <maven.dependency.plugin.version>3.11.0</maven.dependency.plugin.version>
        <maven.install.plugin.version>3.2.0</maven.install.plugin.version>
        <maven.jar.plugin.version>3.5.1</maven.jar.plugin.version>
        <maven.resources.plugin.version>3.5.0</maven.resources.plugin.version>
        <maven.site.plugin.version>3.22.0</maven.site.plugin.version>
        <flatten.plugin.version>1.8.0</flatten.plugin.version>
        <spotbugs.plugin.version>4.10.5.0</spotbugs.plugin.version>
        <spotless.plugin.version>3.11.0</spotless.plugin.version>
        <!-- Not tracked by Dependabot (it is not a dependency coordinate): bump by hand alongside Spotless -->
        <google-java-format.version>2.0.0</google-java-format.version>
        <sonar.plugin.version>5.8.0.7211</sonar.plugin.version>
        <pitest.plugin.version>1.30.2</pitest.plugin.version>
        <pitest.junit5.plugin.version>1.2.3</pitest.junit5.plugin.version>
        <!-- PIT worker threads for the opt-in mutation profile; override with -Dpitest.threads=N -->
        <pitest.threads>4</pitest.threads>
        <micrometer.version>1.17.2</micrometer.version>
        <prometheus.metrics.version>1.10.0</prometheus.metrics.version>
        <!-- Empty default so @{argLine} in Surefire resolves when JaCoCo is skipped -->
        <argLine/>
        <!--
            JaCoCo coverage floors (BUNDLE covered ratio). Modules override these in their own pom as a
            ratchet just below their measured unit-test coverage; see docs/development/building-the-project.md.
        -->
        <jacoco.min.class>0.00</jacoco.min.class>
        <jacoco.min.method>0.00</jacoco.min.method>
        <jacoco.min.line>0.00</jacoco.min.line>
        <jacoco.min.branch>0.00</jacoco.min.branch>
        <!-- SonarCloud analysis; CI runs the scanner after mvn verify, see .github/workflows/pr-build-and-test.yml -->
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.organization>mihkels</sonar.organization>
        <sonar.projectKey>mihkels_open-messaging-benchmark</sonar.projectKey>
        <!-- Reports written by the jacoco-maven-plugin report execution in every module -->
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/*/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- Same CLI entry points the jacoco-maven-plugin excludes; otherwise Sonar counts them as 0% covered -->
        <sonar.coverage.exclusions>**/benchmark/worker/BenchmarkWorker.java,**/benchmark/worker/DriverProcessMain.java</sonar.coverage.exclusions>
        <!--
          Rules suppressed as verified false positives / deliberate design, see issue #146:
          - S3077: volatile fields only publish immutable or thread-safe objects (Thread, Path, clients)
          - S1181: Throwable is caught only to aggregate, propagate or rethrow failures during cleanup
          - S6213: `record` is a contextual keyword, legal as a variable/method name
          - S106: CLI entry points print usage and argument errors to stderr before logging is set up
          - S2143: AMQP BasicProperties.timestamp takes a java.util.Date; Sonar raises it at file level (#169)
        -->
        <sonar.issue.ignore.multicriteria>s3077,s1181,s6213,s106a,s106b,s106c,s2143</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.s3077.ruleKey>java:S3077</sonar.issue.ignore.multicriteria.s3077.ruleKey>
        <sonar.issue.ignore.multicriteria.s3077.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.s3077.resourceKey>
        <sonar.issue.ignore.multicriteria.s1181.ruleKey>java:S1181</sonar.issue.ignore.multicriteria.s1181.ruleKey>
        <sonar.issue.ignore.multicriteria.s1181.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.s1181.resourceKey>
        <sonar.issue.ignore.multicriteria.s6213.ruleKey>java:S6213</sonar.issue.ignore.multicriteria.s6213.ruleKey>
        <sonar.issue.ignore.multicriteria.s6213.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.s6213.resourceKey>
        <sonar.issue.ignore.multicriteria.s106a.ruleKey>java:S106</sonar.issue.ignore.multicriteria.s106a.ruleKey>
        <sonar.issue.ignore.multicriteria.s106a.resourceKey>**/io/openmessaging/benchmark/Benchmark.java</sonar.issue.ignore.multicriteria.s106a.resourceKey>
        <sonar.issue.ignore.multicriteria.s106b.ruleKey>java:S106</sonar.issue.ignore.multicriteria.s106b.ruleKey>
        <sonar.issue.ignore.multicriteria.s106b.resourceKey>**/io/openmessaging/benchmark/worker/BenchmarkWorker.java</sonar.issue.ignore.multicriteria.s106b.resourceKey>
        <sonar.issue.ignore.multicriteria.s106c.ruleKey>java:S106</sonar.issue.ignore.multicriteria.s106c.ruleKey>
        <sonar.issue.ignore.multicriteria.s106c.resourceKey>**/io/openmessaging/benchmark/worker/DriverProcessMain.java</sonar.issue.ignore.multicriteria.s106c.resourceKey>
        <sonar.issue.ignore.multicriteria.s2143.ruleKey>java:S2143</sonar.issue.ignore.multicriteria.s2143.ruleKey>
        <sonar.issue.ignore.multicriteria.s2143.resourceKey>**/io/openmessaging/benchmark/driver/rabbitmq/RabbitMqBenchmarkProducer.java</sonar.issue.ignore.multicriteria.s2143.resourceKey>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
